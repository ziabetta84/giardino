# Header HTTP letti da Cloudflare Pages (GitHub Pages ignora questo file).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()

# Il service worker e la pagina vanno sempre ricontrollati, altrimenti un
# aggiornamento dell'app non arriva finché la cache del browser non scade.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# I file in assets/ hanno l'hash nel nome: si possono tenere per sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
